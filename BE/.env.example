# URL project Supabase kamu (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon / publishable key (aman dipakai di client, dibatasi oleh RLS)
SUPABASE_ANON_KEY=

# service_role key (Project Settings > API) — WAJIB DIRAHASIAKAN, jangan pernah
# dikirim ke frontend. Dipakai untuk operasi admin yang bypass RLS (verifikasi
# psikolog, moderasi paksa, upload ke storage) dan untuk fitur logout (revoke
# refresh token). Backend tetap bisa jalan tanpa ini, tapi endpoint yang butuh
# service role akan menolak permintaan sampai variabel ini diisi.
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret (Project Settings > API > JWT Settings) — dipakai untuk verifikasi
# token Supabase Auth secara lokal (cepat, tanpa panggil API tiap request).
# Kalau dikosongkan, backend fallback verifikasi via Supabase Auth API (lebih lambat).
SUPABASE_JWT_SECRET=

# Daftar origin frontend yang diizinkan CORS, pisahkan dengan koma.
# Contoh: http://localhost:3000,https://binajiwa.app
CORS_ORIGINS=*

# Kode akses Panel Admin (tanpa akun). Siapa pun yang tahu kode ini bisa
# memverifikasi psikolog — gunakan string acak panjang & jangan dibagikan.
# Kosongkan untuk menonaktifkan panel admin.
ADMIN_ACCESS_KEY=
